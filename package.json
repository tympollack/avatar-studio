{
  "name": "@digitalcanopy/avatar-studio",
  "version": "0.2.0",
  "private": true,
  "description": "SunShade Avatar Studio — standalone PWA for avatar and habitat customization",
  "type": "module",
  "main": "./dist/lib/avatar-studio.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/avatar-studio.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:lib",
    "build:app": "tsc && vite build",
    "build:lib": "tsc --project tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "deploy:staging": "wrangler pages deploy dist --project-name=avatar-studio --branch=staging",
    "deploy:production": "wrangler pages deploy dist --project-name=avatar-studio --branch=main"
  },
  "dependencies": {
    "@digitalcanopy/supabase": "^0.1.0",
    "@digitalcanopy/ui": "^0.1.2",
    "clsx": "^2.1.1",
    "konva": "^10.7.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.16",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jest": "^29.7.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "wrangler": "^3.114.17"
  }
}
